<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewmodel="clr-namespace:RangeApp.ViewModel"
    x:Class="RangeApp.Views.SessionOptions"
    x:DataType="viewmodel:SessionOptionsViewModel"
    Title="New Session">

    <ScrollView>
        <VerticalStackLayout
            Padding="10,10,10,400">
            <Grid ColumnDefinitions="100,*"
                RowDefinitions="40,40">
                <Label Text="Name: "
                    VerticalOptions="Center"
                    HorizontalOptions="End"
                    Grid.Column="0"
                    Grid.Row="0" />
                <Entry Text="{Binding Session.Name}"
                    Grid.Column="1"
                    Grid.Row="0">
                    <Entry.Behaviors>
                        <toolkit:EventToCommandBehavior
                            EventName="TextChanged"
                            Command="{Binding NameTextChangedCommand}" />
                    </Entry.Behaviors>
                </Entry>
                <Label Text="Description: "
                    VerticalOptions="Center"
                    HorizontalOptions="End"
                    Grid.Column="0"
                    Grid.Row="1" />
                <Entry Text="{Binding Session.Note}"
                    Grid.Column="1"
                    Grid.Row="1" />
            </Grid>
            <Label Text="{Binding NameStatusMessage}"
                TextColor="Red" />
            <Label Text="Location"
                HorizontalOptions="Center"
                FontSize="Medium" />
            <Grid ColumnDefinitions="100,*"
                RowDefinitions="40">
                <Label Text="Search: "
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    Grid.Column="0" />
                <Entry Text="{Binding LocationSearch}"
                    Grid.Column="1"
                    ClearButtonVisibility="WhileEditing">
                    <Entry.Behaviors>
                        <toolkit:EventToCommandBehavior
                            EventName="TextChanged"
                            Command="{Binding LocationSearchTextChangedCommand}" />
                    </Entry.Behaviors>
                </Entry>
            </Grid>
            <ScrollView Padding="0,0,0,0">
                <Border>
                    <CollectionView x:Name="LocationListView"
                        ItemsSource="{Binding FilteredLocations}"
                        SelectedItem="{Binding Session.Location, Mode=TwoWay}"
                        SelectionChangedCommand="{Binding LocationSelectedCommand }"
                        IsVisible="{Binding ShowLocation}"
                        SelectionMode="Single"
                        MaximumHeightRequest="150">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodel:LocationData">
                                <Border Margin="0,-1,0,-1"
                                    Padding="5">
                                    <Grid ColumnSpacing="5"
                                        ColumnDefinitions="Auto,*,Auto,*">
                                        <Label Text="Name: "
                                            Grid.Column="0" />
                                        <Label Text="{Binding Name}"
                                            Grid.Column="1" />
                                        <Label Text=" Shooting Direction(deg): "
                                            Grid.Column="2" />
                                        <Label Text="{Binding ShootingDirection}"
                                            Grid.Column="3" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </ScrollView>
            <Grid ColumnDefinitions="*,*" 
                  ColumnSpacing="10">
                <Button Text="Set Location"
                    Command="{Binding AddLocationCommand}"
                    Margin="0,10,0,0"
                    Grid.Column="0" />
                <Button Text="New Location"
                    Command="{Binding NewLocationCommand}"
                    Margin="0,10,0,0"
                    Grid.Column="1" />

            </Grid>

            <Label Text="Firearms"
                HorizontalOptions="Center"
                FontSize="Medium"
                Padding="0,30,0,0" />
            <Label Text="In Session"
                HorizontalOptions="Center"
                TextDecorations="Underline" />
            <ScrollView>
                <Border>
                    <CollectionView
                        ItemsSource="{Binding FirearmsInSession}"
                        SelectedItem="{Binding SelectedFirearmInSession, Mode=TwoWay}"
                        SelectionChangedCommand="{Binding FirearmSelectedCommand}"
                        SelectionMode="Single"
                        MaximumHeightRequest="200">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodel:FirearmData">
                                <Border Margin="-1">
                                    <Grid ColumnDefinitions="Auto,*,Auto,*"
                                        MinimumHeightRequest="30">
                                        <Label Text="Name: "
                                            Margin="0,0,10,0"
                                            VerticalOptions="Center"
                                            Grid.Column="0" />
                                        <Label Text="{Binding Name}"
                                            VerticalOptions="Center"
                                            HorizontalOptions="Start"
                                            Grid.Column="1" />
                                        <Label Text="Caliber: "
                                            Margin="0,0,10,0"
                                            VerticalOptions="Center"
                                            HorizontalOptions="Start"
                                            Grid.Column="2" />
                                        <Label Text="{Binding Caliber}"
                                            VerticalOptions="Center"
                                            HorizontalOptions="Center"
                                            Grid.Column="3" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </ScrollView>
            <Button Text="Remove From Session"
                IsVisible="{Binding FirearmRemoveButtonVisible}"
                IsEnabled="{Binding FirearmRemoveButtonClickable}"
                Command="{Binding RemoveFirearmCommand}" />

            <Label Text="Avialable"
                HorizontalOptions="Center"
                Padding="0,10,0,0"
                TextDecorations="Underline" />
            <Grid ColumnDefinitions="100,*"
                RowDefinitions="40">
                <Label Text="Search: "
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    Grid.Column="0" />
                <Entry Text="{Binding FirearmSearch}"
                    Grid.Column="1"
                    ClearButtonVisibility="WhileEditing">
                    <Entry.Behaviors>
                        <toolkit:EventToCommandBehavior
                            EventName="TextChanged"
                            Command="{Binding FirearmSearchTextChangedCommand}" />
                    </Entry.Behaviors>
                </Entry>
            </Grid>
            <ScrollView>
                <Border>
                    <CollectionView
                        ItemsSource="{Binding FilteredFirearms}"
                        SelectedItem="{Binding SelectedFirearm, Mode=TwoWay}"
                        SelectionMode="Single"
                        MaximumHeightRequest="200">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodel:FirearmData">
                                <Border Margin="-1">
                                    <Grid ColumnDefinitions="Auto,*,Auto,*"
                                        MinimumHeightRequest="30">
                                        <Label Text="Name: "
                                            Margin="0,0,10,0"
                                            VerticalOptions="Center"
                                            Grid.Column="0" />
                                        <Label Text="{Binding Name}"
                                            VerticalOptions="Center"
                                            HorizontalOptions="Start"
                                            Grid.Column="1" />
                                        <Label Text="Caliber: "
                                            Margin="0,0,10,0"
                                            VerticalOptions="Center"
                                            HorizontalOptions="Start"
                                            Grid.Column="2" />
                                        <Label Text="{Binding Caliber}"
                                            VerticalOptions="Center"
                                            HorizontalOptions="Center"
                                            Grid.Column="3" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </ScrollView>
            <Grid ColumnDefinitions="*,*"
                Padding="0,10,0,0"
                ColumnSpacing="10">
                <Button Text="Add To Session"
                    Command="{Binding AddFirearmCommand}"
                    Grid.Column="0" />
                <Button Text="New Firearm"
                    Command="{Binding NewFirearmCommand}"
                    Grid.Column="1" />
            </Grid>
            <Label Text="{Binding AddFirearmStatusMessage}" />

            <Button Text="Start Session"
                Margin="0,20,0,0"
                Command="{Binding SaveSessionCommand}" />
            <Label Text="{Binding StatusMessage}" />
        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
